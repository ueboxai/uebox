{
  "name": "unreal-box",
  "version": "1.0.4",
  "description": "虚幻盒子",
  "main": "./out/main/index.js",
  "author": "虚幻盒子科技有限公司",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ueboxai/uebox",
  "updateGithubRepo": "ueboxai/uebox",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "node scripts/check-lint-baseline.mjs",
    "lint:baseline:update": "node scripts/check-lint-baseline.mjs --update",
    "palette": "node scripts/gen-palette.mjs",
    "lint:all": "eslint --cache src tests scripts electron.vite.config.ts vitest.config.ts eslint.config.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "verify:changed": "node scripts/verify.mjs --changed",
    "docs:check": "node scripts/check-docs-sync.mjs",
    "site:dev": "vitepress dev website",
    "site:build": "vitepress build website",
    "site:preview": "vitepress preview website",
    "site:check": "pnpm -s site:build && node scripts/check-docs-anchors.mjs",
    "site:shots": "node scripts/capture-docs-shots.mjs",
    "lore:fetch": "node scripts/fetch-lore-cli.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "plugin:check:all": "node scripts/build-plugin.mjs --check --all",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:build:all": "node scripts/build-all-plugins.mjs",
    "plugin:release": "node scripts/release-plugin.mjs",
    "release:app": "node scripts/release-app.mjs",
    "release:dl": "node scripts/release-dl.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high --registry=https://registry.npmjs.org",
    "security:secrets": "node scripts/check-secrets.mjs",
    "verify:overrides": "node scripts/check-overrides-sync.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:cli": "tsc --noEmit -p tsconfig.cli.json",
    "typecheck:changed": "node scripts/typecheck-changed.mjs",
    "typecheck": "pnpm -s run typecheck:node && pnpm -s run typecheck:web && pnpm -s run typecheck:cli",
    "test": "vitest",
    "test:run": "node scripts/better-sqlite3-abi.mjs ensure node && vitest run",
    "test:run:fast": "vitest run",
    "test:related": "node scripts/test-related.mjs",
    "test:run:node": "pnpm -s run test:run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:reporter": "vitest run --reporter=verbose --reporter=json --reporter=html",
    "tools:usage": "node scripts/tool-usage-report.mjs",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=16384 --expose-gc\" electron-vite preview",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=16384 --expose-gc\" electron-vite dev --mode development",
    "dev:electron": "npm run rebuild:electron && npm run dev",
    "dev:test": "cross-env NODE_OPTIONS=\"--max-old-space-size=16384 --expose-gc\" electron-vite dev --mode test",
    "dev:ue-verify": "cross-env NODE_OPTIONS=\"--max-old-space-size=16384 --expose-gc\" HTTP_ENABLED=true HTTP_HOST=127.0.0.1 HTTP_PORT=8766 electron-vite dev --mode development",
    "dev:smoke": "cross-env NODE_OPTIONS=\"--max-old-space-size=16384 --expose-gc\" HTTP_ENABLED=true HTTP_HOST=127.0.0.1 HTTP_PORT=8766 WS_PORT=8765 electron-vite dev --mode development",
    "test:smoke": "pnpm -s dev:smoke",
    "build": "npm run typecheck && npm run rebuild && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" electron-vite build --mode production",
    "build:test": "npm run typecheck && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" electron-vite build --mode test",
    "postinstall": "install-electron && node scripts/better-sqlite3-abi.mjs use electron",
    "verify:packaged-deps": "node scripts/check-packaged-deps.mjs",
    "verify:official-endpoints": "node scripts/check-official-endpoints.mjs",
    "verify:local-storage": "node scripts/check-local-storage.mjs",
    "verify:colors": "node scripts/check-colors.mjs",
    "verify:skills": "node scripts/check-skills.mjs",
    "verify:ue-file-reads": "node scripts/check-ue-file-reads.mjs",
    "verify:cli-package": "cd packages/cli && npx tsc -p tsconfig.json && node scripts/check-package.mjs",
    "verify:offline-boot": "node scripts/verify-offline-boot.mjs",
    "build:cli": "node scripts/build-cli-bundle.mjs",
    "build:unpack": "npm run build && npm run build:cli && electron-builder --dir && npm run verify:packaged-deps",
    "build:win": "npm run plugin:build:all && npm run plugin:check:all && node scripts/fetch-lore-cli.mjs --check && npm run build && npm run build:cli && node scripts/build-win-installer.js && npm run verify:packaged-deps",
    "build:mac": "npm run plugin:check:all && npm run build && npm run build:cli && node scripts/build-mac-installer.mjs && npm run verify:packaged-deps",
    "build:linux": "npm run plugin:check:all && npm run build && electron-builder --linux",
    "rebuild": "pnpm -s run rebuild:electron",
    "rebuild:electron": "node scripts/better-sqlite3-abi.mjs use electron",
    "rebuild:node": "node scripts/better-sqlite3-abi.mjs use node",
    "docs:freshness": "node scripts/check-docs-freshness.mjs",
    "rebuild:abi:status": "node scripts/better-sqlite3-abi.mjs status"
  },

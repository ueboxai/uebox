{
  "name": "uebox-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Unreal Box CLI — 让外部 Agent、开发者和脚本通过终端调用虚幻盒子的 UE 能力",
  "type": "module",
  "bin": {
    "uebox": "./dist/index.js"
  },
  "files": ["dist", "skills", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "verify:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
